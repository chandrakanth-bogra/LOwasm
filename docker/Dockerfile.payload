# A built LOwasm payload, served by nginx. Built by scripts/publish-ghcr.sh,
# which passes the payload directory as the build context and documents how to
# run or extract the image.
FROM nginx:alpine

COPY nginx-payload.conf /etc/nginx/conf.d/default.conf
COPY dist/ /usr/share/nginx/html/

# Fail the build rather than ship a payload that cannot start.
RUN set -e; \
    for f in cool.html online.js online.wasm soffice.data soffice.data.js.metadata lowasm.js; do \
        [ -s "/usr/share/nginx/html/$f" ] || { echo "missing or empty: $f" >&2; exit 1; }; \
    done

LABEL org.opencontainers.image.title="LOwasm payload" \
      org.opencontainers.image.description="Collabora Online + LibreOffice compiled to WebAssembly, served by nginx" \
      org.opencontainers.image.licenses="MPL-2.0"
